generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// KULLANICI TABLOSU
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // İleride ADMIN vs. yapmak için
  createdAt DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  stock       Int
  createdAt   DateTime @default(now())
}
